{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "sourceMap": true,
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/main.tsx",
    "src/desktopAdapter.ts",
    "src/assets.d.ts",
    "src/agents/recommendations.ts",
    "src/ai/types/ai.ts",
    "src/models/issue.ts",
    "src/shared/scanCoverage.ts",
    "src/webview/hypothesisAiExecution.ts",
    "src/webview/hypothesisAiConsentMessages.ts",
    "src/webview/ui/**/*.ts",
    "src/webview/ui/**/*.tsx",
    "packages/desktop/src/**/*.ts",
    "packages/cli/src/**/*.ts",
    "packages/core/src/**/*.ts"
  ],
  "exclude": ["dist", "out", "node_modules", "src/test", ".vscode-test", "apps"]
}
